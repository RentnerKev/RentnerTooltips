{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 80,
    "sortPackageJson": false,
    "ignorePatterns": [
        "**/dist/",
        "**/build/",
        "**/node_modules/",
        "bun.lock",
        "**/drizzle/",
        "**/.env",
        "**/.env.*",
        "**/routeTree.gen.ts",
        "**/*.generated.ts",
        "test-results/",
        "playwright-report/"
    ]
}
