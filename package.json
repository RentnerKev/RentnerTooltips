{
    "name": "@rentnerkev/tooltips",
    "version": "0.0.0",
    "description": "A lightweight, customizable React tooltip component powered by Radix UI.",
    "keywords": [
        "react",
        "tooltip",
        "radix-ui",
        "accessibility",
        "ui"
    ],
    "author": "RentnerKev",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerTooltips.git"
    },
    "homepage": "https://github.com/RentnerKev/RentnerTooltips#readme",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerTooltips/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "tailwind.css"
    ],
    "sideEffects": [
        "./tailwind.css"
    ],
    "scripts": {
        "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "pack:check": "npm pack --dry-run --cache .npm-cache",
        "playground:install": "bun install --cwd playground --frozen-lockfile",
        "playground:dev": "bun --cwd playground dev",
        "playground:typecheck": "bunx --bun tsc --noEmit -p playground/tsconfig.json",
        "playground:build": "bun --cwd playground build",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt package.json src playground tailwind.css .github bunfig.toml tsconfig.json .oxfmtrc.json .oxlintrc.json",
        "format:check": "oxfmt --check package.json src playground tailwind.css .github bunfig.toml tsconfig.json .oxfmtrc.json .oxlintrc.json",
        "verify": "bun run playground:install && bun run typecheck && bun run playground:typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run playground:build && bun run pack:check"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "@radix-ui/react-tooltip": "^1.2.16"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.82.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^7.0.2"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./tailwind.css": "./tailwind.css",
        "./tooltip": {
            "types": "./dist/CustomTooltip.d.ts",
            "import": "./dist/CustomTooltip.js",
            "default": "./dist/CustomTooltip.js"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": "./dist/types.js",
            "default": "./dist/types.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "packageManager": "bun@1.4.2"
}
